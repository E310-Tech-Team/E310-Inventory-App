# Copy this file to .env.local and fill in your Supabase project values.

# Supabase Project URL, for example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Server-only key. Newer Supabase projects may call this a secret key.
# Never expose this in client components or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Optional email notification provider configuration.
# For Resend (Recommended):
# RESEND_API_KEY=
# EMAIL_FROM=E310 IT Support <it-support@r4cglobal.org>

# For SendGrid:
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=Inventory Admin

# For Mailgun:
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM_EMAIL=

# Optional app URL used to build action links in emails.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

